    "Ornament": "src/components/Ornament.jsx",
    "About": "src/components/About.jsx",
    "Featured": "src/components/Featured.jsx",
    "Platforms": "src/components/Platforms.jsx",
    "Episodes": "src/components/Episodes.jsx",
    "Hosts": "src/components/Hosts.jsx",
    "Faq": "src/components/Faq.jsx",
    "Footer": "src/components/Footer.jsx",
    "SpotifyIcon": "src/components/Icons.jsx",
    "AppleIcon": "src/components/Icons.jsx",
    "YouTubeIcon": "src/components/Icons.jsx",
    "TelegramIcon": "src/components/Icons.jsx",
    "InstagramIcon": "src/components/Icons.jsx",
    "Mp3Icon": "src/components/Icons.jsx",
    "RssIcon": "src/components/Icons.jsx",
    "PlayIcon": "src/components/Icons.jsx",
    "PauseIcon": "src/components/Icons.jsx"
  },
  "docsDir": ".design-sync/docs",
