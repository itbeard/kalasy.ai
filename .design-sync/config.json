{
  "projectId": "85658cf0-3e49-41d9-b91c-5b07e18cc389",
  "shape": "package",
  "pkg": "kalasy-ai",
  "globalName": "KalasyAI",
  "buildCmd": "node .design-sync/gen-content-shims.mjs",
  "entry": ".design-sync/ds-entry.js",
  "tsconfig": ".design-sync/tsconfig.json",
  "srcDir": "src/components",
  "cssEntry": ".design-sync/.cache/styles-entry.css",
  "extraFonts": [
    ".design-sync/fonts/fonts.css"
