{
  // Sync-only tsconfig (cfg.tsconfig). Two jobs:
  //  - map the Vite `?raw` md imports in src/i18n.jsx onto generated shim
  //    modules so plain esbuild can bundle them
  //  - map the absolute site-asset url in Hero.css onto a 1x1 png placeholder
  //    (the real photo is restored via cfg.cssEntry data-URI overrides)
  // All targets are regenerated by .design-sync/gen-content-shims.mjs (cfg.buildCmd).
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "../content/be.md?raw": ["./.cache/content-shims/be.js"],
      "../content/en.md?raw": ["./.cache/content-shims/en.js"],
      "/assets/bg-hero.jpg": ["./.cache/assets/blank.png"]
    }
  }
}
